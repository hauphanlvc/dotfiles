[Desktop Entry]
Type=Application
Name=Obsidian
Comment=Knowledge base that works on top of a local folder of plain text Markdown files
Exec=/opt/Obsidian/obsidian --ozone-platform=wayland --enable-wayland-ime %U
Icon=obsidian
Terminal=false
Categories=Office;
MimeType=x-scheme-handler/obsidian;
StartupWMClass=obsidian
