#!/bin/sh
# Reset the ELAN0676:00 I2C HID touchpad, keep the I2C controller active,
# and isolate touchpad IRQs from CPU0 (ACPI EC) after S3 suspend/resume

case "$1" in
    post)
        for ctrl in /sys/devices/pci0000:00/0000:00:15.0/power/control \
                    /sys/devices/pci0000:00/0000:00:15.0/i2c_designware.0/power/control \
                    /sys/bus/i2c/devices/i2c-ELAN0676:00/power/control; do
            [ -w "$ctrl" ] && echo on > "$ctrl"
        done

        [ -w /sys/module/workqueue/parameters/power_efficient ] && echo N > /sys/module/workqueue/parameters/power_efficient

        if [ -e /sys/bus/i2c/drivers/i2c_hid_acpi/i2c-ELAN0676:00 ]; then
            echo "i2c-ELAN0676:00" > /sys/bus/i2c/drivers/i2c_hid_acpi/unbind 2>/dev/null || true
            sleep 0.2
            echo "i2c-ELAN0676:00" > /sys/bus/i2c/drivers/i2c_hid_acpi/bind 2>/dev/null || true
        fi

        i2c_irq=$(awk '/i2c_designware\.0/{sub(":","",$1); print $1; exit}' /proc/interrupts 2>/dev/null || true)
        hid_irq=$(awk '/ELAN0676:00/{sub(":","",$1); print $1; exit}' /proc/interrupts 2>/dev/null || true)
        [ -n "$i2c_irq" ] && [ -w "/proc/irq/$i2c_irq/smp_affinity_list" ] && echo 2 > "/proc/irq/$i2c_irq/smp_affinity_list" 2>/dev/null || true
        [ -n "$hid_irq" ] && [ -w "/proc/irq/$hid_irq/smp_affinity_list" ] && echo 3 > "/proc/irq/$hid_irq/smp_affinity_list" 2>/dev/null || true
        ;;
esac
